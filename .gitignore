# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
**/dist/

# Env files (never commit secrets)
.env
.env.*
!.env.example
!**/.env.example

# SQLite data (persisted via Docker volume / Fly volume instead)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-shm
backend/data/*.db-wal

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Misc local overrides
*.local
